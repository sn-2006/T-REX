# Copy this file to .env and fill in your own values.
# NEVER commit .env or share these values — especially PRIVATE_KEY.

# Optional MST Testnet RPC override; defaults to the public MST Testnet RPC.
MST_RPC_URL=https://testnetrpc.mstblockchain.com

# Private key of a wallet dedicated to this project ONLY.
# Fund the deploying account with tMSTC on MST Testnet; never use a wallet
# that holds real funds for this.
PRIVATE_KEY=
