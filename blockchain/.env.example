# Copy this file to .env and fill in your own values.
# NEVER commit .env or share these values — especially PRIVATE_KEY.

# Your Alchemy app's HTTPS URL for the Polygon Amoy network
# e.g. https://polygon-amoy.g.alchemy.com/v2/your-api-key
AMOY_RPC_URL=

# Private key of a wallet dedicated to this project ONLY.
# Fund it with test MATIC from a Polygon Amoy faucet — never use a wallet
# that holds real funds for this.
PRIVATE_KEY=
