# Copy to .env and fill in after deploying the contract (see /blockchain).
# Leave blank to keep running the app in mocked/local-storage mode.
#
# `npm run deploy:local` or `npm run deploy:amoy` (inside /blockchain)
# prints the exact lines to paste here — just copy them in.

VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=
VITE_CHAIN_ID_HEX=
VITE_CHAIN_NAME=
VITE_CURRENCY_SYMBOL=
VITE_EXPLORER_URL=

# --- AI Compliance Explainability layer ------------------------------------
# Leave everything below blank/default to run entirely on the built-in
# template explainer (no LLM, no API key, works offline). To use a real
# model, point these at either:
#   - a local Ollama install (default) — just `ollama pull llama3.1` and
#     `ollama serve`, no API key needed
#   - a hosted OpenAI-compatible Llama endpoint (Groq, Together, etc.) —
#     set VITE_LLM_API_MODE=openai and VITE_LLM_API_KEY
#
# The AI layer only ever EXPLAINS numbers the deterministic reconciliation
# engine already computed — it never calculates tax/TDS itself.

VITE_LLM_BASE_URL=http://localhost:11434
VITE_LLM_MODEL=llama3.1
VITE_LLM_API_MODE=ollama
VITE_LLM_API_KEY=

